# Environment Variables Example for ChitFund Pro
PORT=5000
NODE_ENV=production

# Database Connection (Provide either DATABASE_URL or individual parameters)
# Option A: Full Connection String (Cloud MySQL / Aiven / TiDB / Railway / PlanetScale)
DATABASE_URL=mysql://user:password@host:3306/database_name

# Option B: Individual credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kameti_db
DB_SSL=false

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Client URL (Only needed if frontend hosted separately)
CORS_ORIGIN=*
